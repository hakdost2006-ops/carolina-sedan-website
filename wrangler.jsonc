{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "carolina-sedan-website",
  "main": "worker.js",
  "compatibility_date": "2026-05-17",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}
